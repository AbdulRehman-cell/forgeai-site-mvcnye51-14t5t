# Server Environment Configuration
NODE_ENV=production
PORT=10000

# Database Connection (MongoDB)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/forgeai_db

# Security & Authentication
# Strong random string (minimum 32 characters) used to sign JSON Web Tokens
JWT_SECRET=super_secret_jwt_key_replace_this_in_production

# CORS Configuration
# Allowed origin domain for frontend clients
CLIENT_ORIGIN=https://forgeai-site-mvcnye51.onrender.com
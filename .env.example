# Server Network Configuration
PORT=10000
NODE_ENV=production

# Database Connection String (MongoDB Atlas or Render Internal Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dbname
MONGODB_URI=mongodb://localhost:27017/forgeai

# Security & Authentication
# Generate a strong key via openssl: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here

# CORS Configuration (URL of your frontend app)
CLIENT_ORIGIN=https://forgeai-site-mvcnye51.onrender.com